<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NextCloudShot.Desktop.Views.MainWindow"
        Title="NextCloudShot" Width="680" Height="530" MinWidth="560" MinHeight="470">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="28">
    <StackPanel Spacing="5">
      <TextBlock Classes="heading" Text="CloudShot" />
      <TextBlock Foreground="#B8C1CC" Text="Screenshots to your Nextcloud with instant public links" />
    </StackPanel>

    <Border Grid.Row="1" Margin="0,26,0,22" Padding="18" CornerRadius="8" Background="#161C23">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="145,*" RowSpacing="12" ColumnSpacing="12">
        <TextBlock VerticalAlignment="Center" Text="Server URL" />
        <TextBox Grid.Column="1" Text="{Binding ServerUrl}" Watermark="https://cloud.example.ru/" />
        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Username" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Username}" />
        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="App password" />
        <TextBox Grid.Row="2" Grid.Column="1" PasswordChar="●" Text="{Binding AppPassword}" />
        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Upload folder" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding UploadFolder}" />
        <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding CreatePublicLink}" Content="Create public link after upload" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
      <Button Classes="primary" Command="{Binding CaptureRegionCommand}" Content="Capture region  (PrintScreen)" />
      <Button Command="{Binding CaptureWindowCommand}" Content="Capture window  (Alt + PrintScreen)" />
      <Button Command="{Binding TestConnectionCommand}" Content="Test cloud" />
    </StackPanel>

    <Border Grid.Row="3" Margin="0,22,0,0" Background="#10151B" CornerRadius="6" Padding="12">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#BBC6D2" />
    </Border>
  </Grid>
</Window>
